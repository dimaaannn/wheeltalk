<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Чистый .NET для Android, без MAUI — тем же составом, что WheelTalk.Droid. Стенд
		     пересобран поверх WheelTalk.Dashboard.Droid по решению плана 12 §1: держать MAUI ради
		     одного стенда дороже, чем собрать его заново. -->
		<TargetFramework>net10.0-android</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>WheelTalk.Lab.Droid</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Отдельный пакет, чтобы стенд стоял на телефоне рядом с рабочим приложением: их
		     сравнивают друг с другом, а не по очереди переустанавливают. -->
		<ApplicationTitle>WheelTalk Lab</ApplicationTitle>
		<ApplicationId>com.wheeltalk.lab.droid</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

		<SupportedOSPlatformVersion>28.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<!-- Нарезка поездок едет внутри пакета: стенд должен работать сразу после установки, без
		     adb push и без правки настроек. У MAUI это был MauiAsset, здесь обычный AndroidAsset —
		     читается через Context.Assets.Open("replay/…"). -->
		<AndroidAsset Include="..\replay\*.csv" Link="Assets\replay\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Логгеры сценариев (NullLoggerFactory) приходят с Microsoft.Extensions.Logging.Abstractions,
		     который тянет WheelTalk.Core. BLE и настройки приложения стенду по-прежнему не нужны. -->
		<ProjectReference Include="..\WheelTalk.Core\WheelTalk.Core.csproj" />
		<ProjectReference Include="..\WheelTalk.Dashboard.Droid\WheelTalk.Dashboard.Droid.csproj" />

		<!-- База — с 04.08.2026, решением владельца: прежнее «стенду базы не надо» пересмотрено, и
		     причина в том, ради чего стенд существует. Плитка-график читает таблицу телеметрии, а
		     стенд обязан показывать тот же путь, каким живёт приложение: со своим генератором точек в
		     памяти он проверял бы то, чего в бою нет, и разошлись бы эти две картинки молча.
		     Стенд получает узкие типы (RideStore на запись, MetricHistoryReader на чтение) — не
		     соединение и не SQL: тем правилом живут все, кроме самого WheelTalk.Storage. -->
		<ProjectReference Include="..\WheelTalk.Storage\WheelTalk.Storage.csproj" />
	</ItemGroup>

</Project>
