<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorPrimary">#512BD4</color>
    <color name="colorPrimaryDark">#2B0B98</color>
    <color name="colorAccent">#2B0B98</color>

    <!-- Задний слой адаптивной иконки — фон панели из палитры «Ванг». Отдельным цветом, а не
         рисунком: launcher анимирует слои друг относительно друга, и заливке для этого нечего
         рисовать сверх одного цвета. -->
    <color name="appicon_background">#101010</color>

    <!-- ================= Палитра документных экранов (план 33) =================

         Дневной набор. Ночной лежит рядом, в values-night/colors.xml, и переключает их сама
         система: смена темы Android — это пересоздание активности, ресурсы при нём читаются
         заново. Поэтому источник ресурсный, а не класс с «если сейчас ночь»: классу пришлось бы
         ловить конфигурацию руками и перекрашивать уже построенные вьюхи.

         Роли, а не цвета: имя говорит, ЧТО красим, — и одна роль может совпасть значением с
         другой в одной теме и разойтись в другой (так, подсказка и стрелка перехода в день
         одинаковы, а ночью нет).

         Приборных поверхностей здесь нет и не будет: панель, «Цифры», плеер, шторка и полосы
         тревоги всегда тёмные (решение владельца 13.08.2026), палитра у них своя, кодом.

         День подобран РАСЧЁТОМ контраста до внесения (WCAG 1.4.3/1.4.11: 4,5:1 текст, 3:1
         компоненты) и проверяется тестом DocumentPaletteTests — числа считает он же, а не глаз. -->

    <!-- Фон страницы: под ним меряется контраст всего, что на ней. -->
    <color name="doc_surface">#FFFFFF</color>

    <!-- Карточка раздела и её обводка: карточка едва отличается от фона, различает её граница —
         те же отношения, что и ночью, только вывернутые по светлоте. -->
    <color name="doc_card">#F2F2F4</color>
    <color name="doc_card_border">#DDDDDD</color>

    <!-- Черта между строками внутри карточки. -->
    <color name="doc_row_divider">#E4E4E6</color>

    <!-- Обводка кнопок и полей: она объявляет орган управления, потому меряется как компонент
         (3:1), а не как украшение. -->
    <color name="doc_border">#858585</color>

    <!-- Отбивка зависимой строки — вертикальная черта, по которой видно, чья строка. Тоже смысл,
         тоже 3:1. -->
    <color name="doc_dependant_bar">#858585</color>

    <color name="doc_text_primary">#000000</color>

    <!-- Заголовок строки настройки: чуть тише основного текста, но всё ещё текст. -->
    <color name="doc_text_title">#1F1F1F</color>

    <!-- Знак на кнопке-квадрате («+», «−» в листе правки). -->
    <color name="doc_text_control">#333333</color>

    <!-- Невыбранное: чип, «Отмена». -->
    <color name="doc_text_muted">#4A4A4A</color>

    <!-- Заголовок раздела, подпись листа снизу. -->
    <color name="doc_text_secondary">#5C5C5C</color>

    <!-- Подсказка под строкой и самая тихая подсказка корня настроек. -->
    <color name="doc_hint">#616161</color>
    <color name="doc_hint_dim">#6B6B6B</color>

    <!-- Стрелка перехода на карточке раздела. -->
    <color name="doc_chevron">#6B6B6B</color>

    <!-- Акцент выбранного и заливка кнопки «Готово». В день он затемнён (решение владельца
         13.08.2026 — «акценты темнить»): сиреневый ночной на белом даёт 1,9:1, читать нечем.
         Взят тот самый #512BD4, которым уже красится светлая кнопка UiKit и colorPrimary темы. -->
    <color name="doc_accent">#512BD4</color>
    <color name="doc_on_accent">#FFFFFF</color>

    <!-- «Своё» — не заводское значение. Янтарь на белом даёт 2,2:1, поэтому в день он уходит в
         тёмную охру: тот же смысл, тот же тон, читаемая яркость. -->
    <color name="doc_override">#8F5200</color>
    <color name="doc_override_fill">#298F5200</color>

    <!-- Подсветка строки, к которой привели ссылкой: гаснет сама. -->
    <color name="doc_highlight">#338F5200</color>

    <color name="doc_link">#1565C0</color>
    <color name="doc_warning">#C62828</color>

    <!-- Выбранное колесо в корне настроек. -->
    <color name="doc_picked">#006B4F</color>

    <!-- Обводка карточки «Что уйдёт»: полупрозрачный серый — он работает на любом фоне, и в обеих
         темах значение одно. -->
    <color name="doc_share_border">#40808080</color>

    <!-- Крайние ячейки батареи на экране «Данные»: самая просевшая и самая полная. День — тёмные
         варианты тех же тонов: OrangeRed и MediumSeaGreen на белом дают 3,4:1 и 2,7:1, то есть
         числа, которые нечем прочесть. -->
    <color name="doc_cell_low">#BF360C</color>
    <color name="doc_cell_high">#00695C</color>

    <!-- Общий разделитель UiKit: рисуется с прозрачностью 0,2 на самой вьюхе — как и прежде. -->
    <color name="doc_divider">#888888</color>
</resources>
