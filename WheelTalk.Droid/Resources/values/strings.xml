<?xml version="1.0" encoding="utf-8"?>
<!-- Строки для системы, а не для экранов. Экранные живут в Resources/Strings/AppStrings.resx и
     читаются строго типизированно (опечатка в ключе — ошибка сборки, план 6 фаза 1). Сюда попадает
     только то, что спрашивает сам Android через манифест: имя приложения под значком и его
     описание. Их .resx отдать не может — манифест читается системой до запуска нашего кода. -->
<resources>
    <string name="app_name">WheelTalk</string>

    <!-- Показывается системой там, где она рассказывает о приложении: сведения о приложении,
         разрешения, некоторые магазины. Одно предложение о том, что это и для кого. -->
    <string name="app_description">Приборная панель моноколеса: телеметрия по Bluetooth, тревоги по ШИМ и скорости, запись поездок.</string>
</resources>
