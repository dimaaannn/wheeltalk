<?xml version="1.0" encoding="utf-8"?>
<!-- Профиль публикации из Visual Studio. https://go.microsoft.com/fwlink/?LinkID=208121.

     Держится в репозитории нарочно: публиковать надо и из студии, и из командной строки, и оба
     пути обязаны давать один и тот же файл в одном и том же месте. Поэтому всё, что определяет
     результат, задано явно здесь и так же — в WheelTalk.Droid.csproj; студии не остаётся ничего,
     что можно было бы додумать по обстановке.

     Два места, где обстановка уже вмешивалась:

     - **Архитектура.** Выбранное в студии устройство (`SelectedDevice` в
       WheelTalk.Droid.csproj.user, у нас — эмулятор x86_64) не должно попадать в релизную сборку:
       смесь arm64 и x86_64 в obj роняет публикацию с XAGJS7009. Подробности — в комментарии к
       RuntimeIdentifiers в csproj.
     - **Куда класть.** Мастер публикации однажды переписал PublishDir на подпапку
       `publish\android-arm64\`, и APK стало два в разных местах — со всеми удовольствиями поиска
       свежего. Каталог здесь тот же, что у `dotnet publish` по умолчанию.

     Соседний FolderProfile.pubxml.user в репозиторий не берётся: там история запусков публикации
     этой машины, а не настройка проекта. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-android</TargetFramework>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <SelfContained>false</SelfContained>
    <PublishDir>bin\Release\net10.0-android\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
